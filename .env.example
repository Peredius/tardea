# Copia estas claves a .env.local. No subas .env.local a GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Necesaria para que TARDEA Scout busque automaticamente en Google/tiqueteras.
SERPER_API_KEY=

# Email para enviar informes de analitica desde el admin.
RESEND_API_KEY=
ANALYTICS_FROM_EMAIL=TARDEA <informes@tardea.com>
ANALYTICS_REPORT_EMAIL=info@tardea.com

# Opcional: contrasena global de la web privada.
SITE_PASSWORD=
